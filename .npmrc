legacy-peer-deps=true

# Local file: deps (the sibling @aio/models-data) install as REAL COPIES
# instead of junctions/symlinks. Junction traversal is denied inside
# restricted-token/AppContainer processes (the "untrusted mount point"
# Windows policy), which breaks `tsc` and `cargo check` for any agent
# running the toolchain from a sandboxed shell — and a real copy works
# everywhere (see docs/zh/development/harness-environment-report.md).
install-links=true
