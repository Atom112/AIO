{
  "name": "aio",
  "version": "0.7.2",
  "description": "A lightweight cross-platform AI assistant desktop client",
  "type": "module",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "vite build",
    "format": "prettier . --write && cargo +1.97.1 fmt --manifest-path src-tauri/Cargo.toml",
    "format:check": "prettier . --check && cargo +1.97.1 fmt --check --manifest-path src-tauri/Cargo.toml",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:docs": "node scripts/check-doc-links.mjs",
    "check:frontend": "npm run check:i18n && npm run check:docs && prettier . --check && npm run lint && npm run typecheck && npm run build",
    "check:rust": "cargo +1.97.1 fmt --check --manifest-path src-tauri/Cargo.toml && cargo +1.97.1 clippy --all-targets --manifest-path src-tauri/Cargo.toml -- -D warnings && cargo +1.97.1 test --manifest-path src-tauri/Cargo.toml",
    "verify": "npm run check:frontend && npm run check:rust",
    "serve": "vite preview",
    "tauri": "tauri"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@aio/models-data": "file:../aio-models-data",
    "@lobehub/icons-static-svg": "^1.91.0",
    "@solid-primitives/i18n": "^2.2.1",
    "@solidjs/router": "^0.16.1",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "cropperjs": "^1.6.2",
    "dompurify": "^3.4.11",
    "highlight.js": "^11.11.1",
    "html-to-image": "^1.11.13",
    "jspdf": "^4.2.1",
    "marked": "^18.0.5",
    "marked-highlight": "^2.2.4",
    "solid-js": "^1.9.13",
    "solid-motionone": "^1.0.4",
    "solid-transition-group": "^0.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tauri-apps/cli": "^2.11.3",
    "@types/node": "^26.0.0",
    "autoprefixer": "^10.5.0",
    "baseline-browser-mapping": "^2.10.38",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-solid": "^0.14.5",
    "globals": "^16.5.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.0.16",
    "vite-plugin-solid": "^2.11.12"
  }
}
